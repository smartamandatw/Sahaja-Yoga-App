[
  {
    "zh": "真正的靜默，",
    "zh2": "是思想的靜止",
    "author": "Shri Mataji"
  },
  {
    "zh": "靜坐不是努力，",
    "zh2": "而是放下努力",
    "author": "Shri Mataji"
  },
  {
    "zh": "你的內在有一份平靜，",
    "zh2": "那是你與生俱來的",
    "author": "Shri Mataji"
  },
  {
    "zh": "昆達里尼是你自己的能量，",
    "zh2": "純潔的，溫柔的",
    "author": "Shri Mataji"
  },
  {
    "zh": "愛是一切靈性成長的基礎，",
    "zh2": "從愛自己開始",
    "author": "Shri Mataji"
  }
]
